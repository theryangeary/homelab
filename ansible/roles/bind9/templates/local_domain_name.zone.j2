$TTL 2d
$ORIGIN {{ local_domain_name }}.
@         IN      SOA   ns.{{ local_domain_name }}. admin.{{ local_domain_name }}. (
                                {{ ansible_facts['date_time']['epoch'] }} ; serial
                                43200 ; refresh
                                900 ; retry
                                345600 ; expire
                                7200 ; minimum
)
                        NS     ns.{{ local_domain_name }}.

           IN      NS      ns.{{ local_domain_name }}.

ns        IN      A       {{ bind9_ip }}
truenas   IN      A       {{ truenas_ip }}
{{ ansible_facts['hostname'] }} IN A {{ ansible_facts['default_ipv4']['address'] }}
jellyfin    IN      CNAME   {{ ansible_facts['hostname'] }}.{{ local_domain_name }}.
navidrome IN     CNAME   {{ ansible_facts['hostname'] }}.{{ local_domain_name }}.
calibre IN     CNAME   {{ ansible_facts['hostname'] }}.{{ local_domain_name }}.
ntfy       IN      CNAME   {{ ansible_facts['hostname'] }}.{{ local_domain_name }}.
lyrion  IN  CNAME   {{ ansible_facts['hostname'] }}.{{ local_domain_name }}.
vikunja IN CNAME  {{ ansible_facts['hostname'] }}.{{ local_domain_name }}.
* IN CNAME {{ ansible_facts['hostname'] }}.{{ local_domain_name }}.

{% if env == 'prod' %}
; Delegate staging subdomain to staging BIND9
ns1staging IN A {{ staging_bind9_ip }}

$ORIGIN {{ local_domain_names['stg'] }}.
$TTL 2d
@ IN NS ns1staging.{{ local_domain_name }}.
{% endif %}
