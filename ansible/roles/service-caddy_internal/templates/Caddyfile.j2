{
    servers {
        trusted_proxies static private_ranges
    }
}

(tls_cert) {
    tls /certs/fullchain.pem /certs/privkey.pem
}

vikunja.{{ caddy_domain }} {
    import tls_cert
    @allowed remote_ip 192.168.0.0/16 100.64.0.0/10
    handle @allowed {
        reverse_proxy http://vikunja:3456
    }
    respond "Access denied" 403
}

ntfy.{{ caddy_domain }} {
    import tls_cert
    @allowed remote_ip 192.168.0.0/16 100.64.0.0/10
    handle @allowed {
        reverse_proxy http://ntfy:80
    }
    respond "Access denied" 403
}

jellyfin.{{ caddy_domain }} {
    import tls_cert
    @allowed remote_ip 192.168.0.0/16 100.64.0.0/10
    handle @allowed {
        reverse_proxy truenas.{{ caddy_domain }}:8096 {
            header_up Host jellyfin.{{ caddy_domain }}
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote}
        }
    }
    respond "Access denied" 403
}

lyrion.{{ caddy_domain }} {
    import tls_cert
    @allowed remote_ip 192.168.0.0/16 100.64.0.0/10
    handle @allowed {
        reverse_proxy truenas.{{ caddy_domain }}:31101 {
            header_up Host lyrion.{{ caddy_domain }}
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote}
        }
    }
    respond "Access denied" 403
}

*.{{ caddy_domain }} {
    import tls_cert
    @allowed remote_ip 192.168.0.0/16 100.64.0.0/10
    handle @allowed {
        reverse_proxy http://caddy:80
    }
    respond "Access denied" 403
}